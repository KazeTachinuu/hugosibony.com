---
import Layout from '~/layouts/Layout.astro';
import PageHeader from '~/components/PageHeader.astro';
import { Icon } from 'astro-icon/components';
import { getCollection } from 'astro:content';

// Most-recently-updated first; ties (same updated day) fall back to newest created date.
const projects = (await getCollection('portfolio', (e) => import.meta.env.DEV || !e.data.draft)).sort(
  (a, b) =>
    +new Date(b.data.updated ?? b.data.date) - +new Date(a.data.updated ?? a.data.date) ||
    +new Date(b.data.date) - +new Date(a.data.date),
);

// "projects" is on every entry, useless as a filter
const counts = new Map<string, number>();
for (const p of projects) for (const c of p.data.categories) if (c !== 'projects') counts.set(c, (counts.get(c) ?? 0) + 1);
const cats = [...counts.keys()].sort();
const icons: Record<string, string> = { epita: '/images/epita-mark.png' };
const epitaCount = counts.get('epita') ?? 0;
---

<Layout title="Portfolio" mainClass="max-w-6xl mx-auto px-6 py-16">
  <PageHeader title="Portfolio" section="portfolio" />

  <div class="project-filters" role="group" aria-label="Filter projects by category">
    <button class="project-filter is-active" data-cat="">
      all<span class="project-filter-count">{projects.length}</span>
    </button>
    {cats.map((c) => (
      <button class="project-filter" data-cat={c}>
        {icons[c] && <img src={icons[c]} alt="" />}{c}<span class="project-filter-count">{counts.get(c)}</span>
      </button>
    ))}
  </div>

  <div class="project-grid grid sm:grid-cols-2 lg:grid-cols-3 gap-5">
    {epitaCount > 0 && (
      <a href="/portfolio/?cat=epita" class="project-card project-group-card" data-group="epita">
        <div class="project-img">
          <img src="/images/projects/epita-tools-cover.svg" alt="" loading="lazy" />
        </div>
        <div class="project-meta">
          <div class="flex items-baseline justify-between gap-3">
            <h2 class="project-title">EPITA Tools</h2>
            <span class="project-date">{epitaCount} tools</span>
          </div>
          <p class="project-desc">The toolbox I built for EPITA students: PIE at home, setup kit, moulinette notifications.</p>
          <span class="project-group-cta">
            browse the toolbox <Icon name="lucide:arrow-right" size={13} />
          </span>
        </div>
      </a>
    )}
    {projects.map((p) => {
      return (
        <a
          href={`/portfolio/${p.id}/`}
          class="project-card"
          data-cats={p.data.categories.join(' ')}
          hidden={p.data.categories.includes('epita')}
        >
          <div class="project-img">
            {p.data.image ? (
              <img src={p.data.image} alt="" loading="lazy" />
            ) : (
              <div class="project-img-empty"><span class="project-img-prompt">❯</span>{p.data.title}</div>
            )}
          </div>
          <div class="project-meta">
            <div class="flex items-baseline justify-between gap-3">
              <h2 class="project-title">{p.data.title}</h2>
              <span class="project-date">{new Date(p.data.date).getFullYear()}</span>
            </div>
            {p.data.description && <p class="project-desc">{p.data.description}</p>}
            {p.data.tech.length > 0 && (
              <div class="project-tech">
                {p.data.tech.map((t) => (
                  <span class="project-tech-item">
                    {t.logo && <img src={t.logo} alt="" />}{t.name.toLowerCase()}
                  </span>
                ))}
              </div>
            )}
          </div>
        </a>
      );
    })}
  </div>

  <script>
    const buttons = Array.from(document.querySelectorAll<HTMLElement>('.project-filter'));
    const cards = Array.from(document.querySelectorAll<HTMLElement>('[data-cats]'));
    const groupCard = document.querySelector<HTMLElement>('[data-group="epita"]');

    // Default view folds the epita tools behind the group card; the epita
    // filter (chip or group card) unfolds them and hides the group card.
    const apply = (cat: string) => {
      for (const b of buttons) b.classList.toggle('is-active', (b.dataset.cat ?? '') === cat);
      for (const card of cards) {
        const cs = (card.dataset.cats ?? '').split(' ');
        card.hidden = cat ? !cs.includes(cat) : cs.includes('epita');
      }
      if (groupCard) groupCard.hidden = !!cat;
    };

    const grid = document.querySelector<HTMLElement>('.project-grid');

    const go = (cat: string) => {
      apply(cat);
      history.replaceState(null, '', cat ? `?cat=${cat}` : location.pathname);
      if (grid) {
        grid.classList.remove('is-filtering');
        void grid.offsetWidth; // restart the card-in animation
        grid.classList.add('is-filtering');
      }
    };

    for (const btn of buttons) {
      btn.addEventListener('click', () => go(btn.dataset.cat ?? ''));
    }
    groupCard?.addEventListener('click', (e) => {
      e.preventDefault();
      go('epita');
    });

    // shareable filter links: /portfolio/?cat=epita
    const initial = new URLSearchParams(location.search).get('cat');
    apply(initial && buttons.some((b) => b.dataset.cat === initial) ? initial : '');
  </script>
</Layout>
