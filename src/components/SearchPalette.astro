---
// Ctrl+K / "/" command palette. Native <dialog> (Esc, focus trap, backdrop,
// scroll-lock via :has() come free) + Pagefind. Rendered once in Layout.
// Any element with [data-search-open] opens it; no standalone /search/ page.
---

<dialog id="search-palette" class="sp" aria-label="Search">
  <div class="sp-card">
    <div class="sp-input-row">
      <svg class="sp-icon" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="11" cy="11" r="8"/><path d="m21 21-4.3-4.3"/></svg>
      <input
        id="sp-input"
        type="text"
        placeholder="Search articles, writeups, snippets…"
        autocomplete="off"
        autocapitalize="none"
        autocorrect="off"
        spellcheck="false"
        role="combobox"
        aria-expanded="false"
        aria-controls="sp-results"
        aria-autocomplete="list"
      />
      <kbd class="sp-esc">esc</kbd>
    </div>

    <div id="sp-results" class="sp-results" role="listbox" aria-label="Search results"></div>

    <div class="sp-footer">
      <span><kbd>↑</kbd><kbd>↓</kbd> navigate</span>
      <span><kbd>↵</kbd> open</span>
      <span><kbd>esc</kbd> close</span>
      <span class="sp-footer-brand">Pagefind</span>
    </div>
  </div>
</dialog>

<script is:inline type="module">
  const dialog = document.getElementById('search-palette');
  const input = document.getElementById('sp-input');
  const resultsEl = document.getElementById('sp-results');
  if (dialog && input && resultsEl) {
    let pagefind = null;
    let debounce;
    let items = [];       // rendered <a> rows
    let active = -1;      // highlighted index

    async function loadPagefind() {
      if (pagefind) return pagefind;
      pagefind = await import('/pagefind/pagefind.js');
      await pagefind.init();
      return pagefind;
    }

    function setActive(i) {
      if (!items.length) { active = -1; return; }
      active = (i + items.length) % items.length;
      items.forEach((el, n) => {
        const on = n === active;
        el.classList.toggle('is-active', on);
        el.setAttribute('aria-selected', on ? 'true' : 'false');
        if (on) el.scrollIntoView({ block: 'nearest' });
      });
    }

    function showState(html) {
      resultsEl.innerHTML = html;
      items = [];
      active = -1;
      input.setAttribute('aria-expanded', 'false');
    }

    async function render(results, query) {
      if (!results || !results.length) {
        showState(query
          ? `<p class="sp-empty">No results for <span>&ldquo;${query.replace(/[<>&]/g, '')}&rdquo;</span></p>`
          : '');
        return;
      }

      const data = await Promise.all(results.slice(0, 12).map((r) => r.data()));
      resultsEl.textContent = '';
      const frag = document.createDocumentFragment();

      data.forEach((item) => {
        const row = document.createElement('a');
        row.className = 'sp-result';
        row.href = item.url;
        row.setAttribute('role', 'option');

        const body = document.createElement('span');
        body.className = 'sp-result-body';

        const title = document.createElement('span');
        title.className = 'sp-result-title';
        title.textContent = (item.meta && item.meta.title) || 'Untitled';
        body.appendChild(title);

        if (item.excerpt) {
          const ex = document.createElement('span');
          ex.className = 'sp-result-excerpt';
          ex.innerHTML = item.excerpt;
          body.appendChild(ex);
        }
        row.appendChild(body);

        const arrow = document.createElement('svg');
        arrow.innerHTML = '<svg class="sp-result-go" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14M13 6l6 6-6 6"/></svg>';
        row.appendChild(arrow.firstChild);

        row.addEventListener('mousemove', () => setActive(items.indexOf(row)));
        frag.appendChild(row);
      });

      resultsEl.appendChild(frag);
      items = Array.from(resultsEl.querySelectorAll('.sp-result'));
      input.setAttribute('aria-expanded', 'true');
      setActive(0);
    }

    async function search(query) {
      if (!query) { showState(''); return; }
      try {
        const pf = await loadPagefind();
        const res = await pf.search(query);
        await render(res.results, query);
      } catch {
        showState('<p class="sp-empty">Search index unavailable. Run <span>bun run build</span> first.</p>');
      }
    }

    input.addEventListener('input', () => {
      clearTimeout(debounce);
      debounce = setTimeout(() => search(input.value.trim()), 120);
    });

    input.addEventListener('keydown', (e) => {
      if (e.key === 'ArrowDown') { e.preventDefault(); setActive(active + 1); }
      else if (e.key === 'ArrowUp') { e.preventDefault(); setActive(active - 1); }
      else if (e.key === 'Enter' && active >= 0 && items[active]) {
        e.preventDefault();
        window.location.href = items[active].href;
      }
    });

    function open() {
      if (dialog.open) return;
      // Close any other open dialog (e.g. the mobile menu) so we don't stack.
      document.querySelectorAll('dialog[open]').forEach((d) => d !== dialog && d.close());
      dialog.showModal();
      requestAnimationFrame(() => input.focus());
    }

    // Click the backdrop (the dialog element itself, outside the card) to close.
    dialog.addEventListener('click', (e) => { if (e.target === dialog) dialog.close(); });
    dialog.addEventListener('close', () => { input.value = ''; showState(''); });

    document.addEventListener('click', (e) => {
      if (e.target.closest('[data-search-open]')) { e.preventDefault(); open(); }
    });

    document.addEventListener('keydown', (e) => {
      const t = e.target;
      const editing = t && (t.tagName === 'INPUT' || t.tagName === 'TEXTAREA' || t.isContentEditable);
      if ((e.metaKey || e.ctrlKey) && e.key.toLowerCase() === 'k') { e.preventDefault(); open(); return; }
      if (editing || e.metaKey || e.ctrlKey || e.altKey) return;
      if (e.key === '/') { e.preventDefault(); open(); }
    });
  }
</script>
